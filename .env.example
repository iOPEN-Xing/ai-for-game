# 本地运行可留空。阿里云通过 Compose 启用公网模式，制作台仅经 SSH 转发访问。
STUDIO_ACCESS_KEY=
DOMAIN=
ACME_EMAIL=
# 公网首页样片：harbor（港湾引航）或 tidal（潮汐信标）
SAMPLE_GAME=harbor
# 切换到已恢复的数据卷时填写。容器内数据目录始终为 /data。
STUDIO_VOLUME=loop-data
# 本机连接其他试玩域名时可填。Compose 从 DOMAIN 自动生成。
# STUDIO_PUBLIC_URL=https://games.example.com
# 本地数据目录默认 ./data
# STUDIO_DATA_DIR=/absolute/path/to/data

# 0 仅检索本地资料，1 同时使用 Wikimedia。
STUDIO_RESEARCH_ONLINE=1

ZAI_BASE_URL=https://api.z.ai/api/v1
ZAI_WIRE_API=responses
ZAI_MODEL=glm-5.4
ZAI_1_TOKEN=
ZAI_2_TOKEN=
ZAI_EXTRA_TOKEN=

# auto 根据独立的生图密钥选择网关或本地绘制。responses 要求有密钥。
STUDIO_ART_MODE=auto
STUDIO_ART_BASE_URL=https://www.maitokens.top/v1
STUDIO_ART_RESPONSE_MODEL=gpt-image-2
STUDIO_ART_IMAGE_MODEL=gpt-image-2
STUDIO_ART_API_KEY=

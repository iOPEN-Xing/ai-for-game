{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	@home {
		method GET HEAD
		path /
	}
	redir @home /sample?game=harbor 302
	@player {
		method GET HEAD
		path /sample /play/* /cartridges/v1/* /static/play-host.js /static/api-client.js /static/player-routes.js /static/frame.html /static/player.css /static/sample-game.json /static/sample-harbor.json
	}
	@events {
		method POST
		path_regexp events ^/(api/play/[^/]+/open|api/rounds/[^/]+/(event|feedback|hint)|go/[^/]+)$
	}
	handle @player {
		reverse_proxy app:7860 {
			header_up -Cookie
			header_up -X-Atelier-Session
			header_up -Authorization
		}
	}
	handle @events {
		request_body {
			max_size 3MB
		}
		reverse_proxy app:7860 {
			header_up -Cookie
			header_up -X-Atelier-Session
			header_up -Authorization
		}
	}
	handle {
		respond 404
	}
}
